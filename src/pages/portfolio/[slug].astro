---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
	<div class="back-row">
		<a href="/portfolio">← 作品集列表</a>
		<span class="muted"> · </span>
		<a href="/">首页</a>
	</div>
	<h1 class="page-title">{entry.data.title}</h1>
	<p class="muted">
		GitHub：
		<a href={entry.data.github} target="_blank" rel="noreferrer">
			{entry.data.github}
		</a>
	</p>
	<article class="prose" style="margin-top:1rem;">
		<Content />
	</article>
</Base>
